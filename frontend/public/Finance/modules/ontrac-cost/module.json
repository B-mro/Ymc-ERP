// 1.module.json —— 模块元信息清单

// ShipGrid 的模块加载器靠这个文件知道：
//   1) 模块唯一标识 id、标题、版本号
//   2) 入口 HTML 文件 entry（index.html）
//   3) 计算引擎对外暴露的全局变量名 engineGlobal = OnTracEngine
//   4) JS 依赖的加载顺序 loadOrder
//      （Vue 3 → 运行时 → 重量政策 → XLSX → 内置费率 → 燃油 → 引擎 → UI）
//   5) sourceSHA256 是原始源码文件的哈希，用来校验文件是否被篡改
// 这个文件本身不参与运行，只被宿主平台读取后按顺序注入 <script> 标签。

{
	"id": "ontrac-cost",
	"title": "OnTrac A/B成本测算",
	"version": "3.76-modular.1",
	"entry": "index.html",
	"engineGlobal": "OnTracEngine",
	"engineFile": "engine/ontrac-cost.js",
	"loadOrder": [
		"config.js",
		"vendor/vue.global.prod.js",
		"shared/module-runtime.js",
		"shared/billing-weight-policy.js",
		"vendor/xlsx.full.min.js",
		"data/ontrac-default-rates.js",
		"data/ontrac-fuel.js",
		"engine/ontrac-cost.js",
		"ui/ontrac-cost.js"
	],
	"dependsOnOtherModuleDirectories": false,
	"sourceVersion": "V3.76",
	"sourceSHA256": "8f242354828836bcafdbeefb126054b7aab70e7dd69cbbbf916b6ac34af9230e"
}
