<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rbac.mapper.SysDataInterfaceMapper">

    <select id="selectPageWithCategory" resultType="com.example.rbac.entity.SysDataInterface">
        SELECT i.*, c.name AS category_name
        FROM sys_data_interface i
        LEFT JOIN sys_data_interface_category c ON i.category_id = c.id
        <where>
            <if test="name != null and name != ''">
                AND i.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="method != null and method != ''">
                AND i.method = #{method}
            </if>
            <if test="categoryId != null">
                AND i.category_id = #{categoryId}
            </if>
        </where>
        ORDER BY i.id DESC
    </select>

</mapper>